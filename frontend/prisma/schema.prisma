  // Prisma schema — Product Support / Diagnostic Assistant platform
// Prisma 7 "prisma-client" generator (ESM, driver-adapter based).
// The datasource URL is injected at CLI time via prisma.config.ts,
// and at runtime via the pg driver adapter (see app/lib/prisma.ts).

generator client {
  provider = "prisma-client"
  output   = "../app/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum ResourceType {
  PDF
  DOC
  IMAGE
  VIDEO
  LINK
}

enum Role {
  USER
  ASSISTANT
}

enum MaintenanceStatus {
  PENDING
  DONE
  OVERDUE
}

enum ConversationStatus {
  ACTIVE
  RESOLVED
}

enum RecallSeverity {
  NOTICE // informational: service campaign, firmware advisory
  SAFETY // safety notice: use with caution
  RECALL // formal recall: stop use / return
}

model Company {
  id        String    @id @default(cuid())
  name      String
  email     String
  createdAt DateTime  @default(now())

  products  Product[]
}

model Product {
  id          String   @id @default(cuid())
  companyId   String
  name        String
  category    String
  description String?
  imageUrl    String?
  /** Manufacturer warranty length in months; null = no stated warranty. */
  warrantyMonths Int?
  createdAt   DateTime @default(now())

  company          Company           @relation(fields: [companyId], references: [id], onDelete: Cascade)
  resources        Resource[]
  maintenanceTasks MaintenanceTask[]
  inventory        UserInventory[]
  conversations    Conversation[]
  recalls          Recall[]

  @@index([companyId])
}

model Recall {
  id        String         @id @default(cuid())
  productId String
  title     String
  body      String
  severity  RecallSeverity @default(NOTICE)
  /** Optional link to the full notice / service bulletin. */
  url       String?
  issuedAt  DateTime       @default(now())

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId])
}

model Resource {
  id            String       @id @default(cuid())
  productId     String
  type          ResourceType
  url           String
  title         String
  extractedText String?
  createdAt     DateTime     @default(now())

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId])
}

model User {
  id    String @id @default(cuid())
  name  String
  email String @unique

  inventory          UserInventory[]
  maintenanceStatus  UserMaintenanceStatus[]
  conversations      Conversation[]
}

model UserInventory {
  id          String   @id @default(cuid())
  userId      String
  productId   String
  nickname    String?
  purchasedAt DateTime @default(now())

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([userId, productId])
  @@index([userId])
}

model MaintenanceTask {
  id            String  @id @default(cuid())
  productId     String
  title         String
  intervalDays  Int
  sourceExcerpt String?

  product Product                 @relation(fields: [productId], references: [id], onDelete: Cascade)
  status  UserMaintenanceStatus[]

  @@index([productId])
}

model UserMaintenanceStatus {
  id         String            @id @default(cuid())
  userId     String
  taskId     String
  lastDoneAt DateTime?
  nextDueAt  DateTime?
  status     MaintenanceStatus @default(PENDING)

  user User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  task MaintenanceTask @relation(fields: [taskId], references: [id], onDelete: Cascade)

  @@unique([userId, taskId])
  @@index([userId])
}

model Conversation {
  id        String             @id @default(cuid())
  userId    String
  productId String
  status    ConversationStatus @default(ACTIVE)
  createdAt DateTime           @default(now())

  user     User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  product  Product   @relation(fields: [productId], references: [id], onDelete: Cascade)
  messages Message[]

  @@index([userId])
  @@index([productId])
}

model Message {
  id             String   @id @default(cuid())
  conversationId String
  role           Role
  content        String
  citations      Json?
  createdAt      DateTime @default(now())

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@index([conversationId])
}
